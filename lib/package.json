{
  "name": "core.lib",
  "version": "1.0.0",
  "description": "Core library for moleculer-ts project",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js",
    "./broker": "./dist/broker/index.js",
    "./config": "./dist/config/index.js",
    "./database": "./dist/database/index.js",
    "./fs": "./dist/fs/index.js",
    "./moleculer": "./dist/moleculer/index.js",
    "./adapters/ai": "./dist/adapters/ai/index.js",
    "./adapters/stock-data": "./dist/adapters/stock-data/index.js",
    "./adapters/news": "./dist/adapters/news/index.js"
  },
  "scripts": {
    "build": "rm -rf ./dist && tsc --project tsconfig.build.json",
    "build:copy-json": "rsync --prune-empty-dirs -r --include='*/' --include='*/*.json' --exclude='*' ./ ./dist"
  }
}
