{
  "name": "moleculer-ts",
  "private": true,
  "workspaces": [
    "lib",
    "apps/*/*"
  ],
  "scripts": {
    "build:lib": "bash scripts/build-lib.sh",
    "db:clear": "ts-node scripts/clear-database.ts",
    "init:microservice": "ts-node scripts/init-microservice.ts",
    "generate:types": "ts-node lib/codegen/generate-action-types.ts",
    "generate:types:all": "ts-node lib/codegen/generate-all.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "jaeger:start": "docker compose up -d jaeger",
    "jaeger:stop": "docker compose down jaeger"
  },
  "dependencies": {
    "@google/genai": "^1.44.0",
    "@langchain/core": "^1.1.29",
    "@langchain/textsplitters": "^1.0.1",
    "@toon-format/toon": "^2.1.0",
    "agenda": "^5.0.0",
    "axios": "^1.9.0",
    "brave-search": "^0.9.0",
    "dotenv": "^17.2.3",
    "jaeger-client": "^3.19.0",
    "lodash": "^4.17.23",
    "moleculer": "^0.14.35",
    "moleculer-repl": "^0.7.4",
    "ollama": "^0.5.14",
    "papaparse": "^5.5.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.19.0",
    "pgvector": "^0.2.1",
    "puppeteer": "^24.38.0",
    "rss-parser": "^3.13.0",
    "snoowrap": "^1.23.0",
    "tabula-js": "^1.0.1",
    "typeorm": "^0.3.28",
    "xlsx": "^0.18.5",
    "yahoo-finance2": "^3.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@types/dotenv": "^6.1.1",
    "@types/lodash": "^4.17.23",
    "@types/node": "^20.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.18.0",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
