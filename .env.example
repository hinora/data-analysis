# AI Stock Analysis - Environment Variables Example
# Copy this file to .env and fill in your values

# =============================================================================
# PostgreSQL Configuration
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=analysis_db

# =============================================================================
# Test Database Configuration
# =============================================================================
# Connection URI for the test PostgreSQL instance (docker-compose: postgres-test on port 5433)
TEST_PG_URI=postgresql://postgres:postgres@localhost:5433/postgres

# =============================================================================
# AI Configuration
# =============================================================================
# AI provider: ollama (default), gemini, or lmstudio
AI_PROVIDER=ollama

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Gemini Configuration (if using gemini)
# GEMINI_API_KEY=your-gemini-api-key

# LM Studio Configuration (if using lmstudio)
# LM Studio exposes an OpenAI-compatible REST API. Start the local server from
# the LM Studio app ("Developer" tab) and set the model name as registered there.
# LM_STUDIO_HOST=http://localhost:1234
# LM_STUDIO_MODEL=lmstudio-community/qwen2.5-7b-instruct
# LM_STUDIO_API_KEY=lm-studio

# =============================================================================
# Jaeger Tracing Configuration
# =============================================================================
# Jaeger HTTP collector endpoint (default: http://localhost:14268/api/traces)
# When set, this takes priority over JAEGER_HOST/JAEGER_PORT
JAEGER_ENDPOINT=http://localhost:14268/api/traces
# Jaeger agent host - used only when JAEGER_ENDPOINT is not set
# JAEGER_HOST=127.0.0.1
# Jaeger agent UDP port - used only when JAEGER_ENDPOINT is not set
# JAEGER_PORT=6832
