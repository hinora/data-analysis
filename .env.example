# AI Stock Analysis - Environment Variables Example
# Copy this file to .env and fill in your values

# =============================================================================
# MongoDB Configuration
# =============================================================================
MONGODB_URI=mongodb://localhost:27017

# =============================================================================
# AI Configuration
# =============================================================================
# AI provider: ollama (default) or gemini
AI_PROVIDER=ollama

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:14b

# Gemini Configuration (if using gemini)
# GEMINI_API_KEY=your-gemini-api-key

# =============================================================================
# News API Configuration
# =============================================================================
# NewsAPI.org API key (get from https://newsapi.org)
NEWSAPI_API_KEY=your-newsapi-key

# Finnhub API key (get from https://finnhub.io)
FINNHUB_API_KEY=your-finnhub-key

# Reddit API credentials (for news from Reddit)
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_REFRESH_TOKEN=your-reddit-refresh-token

# =============================================================================
# RSS Feed Configuration
# =============================================================================
# Comma-separated list of RSS feed URLs
RSS_FEED_URLS=https://feeds.finance.yahoo.com/rss/2.0/headline,https://www.investing.com/rss/news.rss

# =============================================================================
# Stock Data Configuration
# =============================================================================
# Stock data provider: yahoo (default)
STOCK_DATA_PROVIDER=yahoo

# =============================================================================
# Timezone Configuration
# =============================================================================
TZ=Asia/Ho_Chi_Minh

# =============================================================================
# Service Ports (optional, for local development)
# =============================================================================
# API_GATEWAY_PORT=3000
# SESSION_SERVICE_PORT=3001
# STOCK_SERVICE_PORT=3002
# NEWS_SERVICE_PORT=3003
# AGENTS_SERVICE_PORT=3004
# SCHEDULER_SERVICE_PORT=3005
