{
  "name": "microservice.proxy",
  "version": "1.0.0",
  "description": "API Gateway proxy microservice using moleculer-web",
  "scripts": {
    "dev": "nodemon --watch . --watch ../../../lib --ext ts,json --exec ts-node app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "generate:types": "npm run generate:types --prefix ../../../ -- --microservice microservice.proxy"
  },
  "dependencies": {
    "core.lib": "file:../../../lib",
    "moleculer-web": "^0.10.8"
  }
}
